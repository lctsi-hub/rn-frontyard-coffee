# Copy to .env.local and fill in. Never commit real values.
# Phase 1 does not read any of these yet; Supabase is connected in a later phase.

# Supabase public values: safe in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key: SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public site URL, used later when generating table QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
