# Copy to .env.local (git-ignored) and fill in locally. Never commit real values.
# The app does not connect to Supabase yet (Phase 5A only prepares the code).

# Supabase public values (Project Settings → API). Safe in the browser:
# the anon key can only do what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phase 5B (pending approval): server-only key used to save orders.
# NEVER prefix with NEXT_PUBLIC_ and never import it in client code.
# SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used later when generating table QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
