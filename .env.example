# Copy to .env.local (git-ignored) and fill in locally. Never commit real values.
# The app does not connect to Supabase yet; without these, Place Order stays in test mode.

# Supabase public values (Project Settings → API). Safe in the browser:
# the anon key can only do what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Used by the Next.js server to save orders (src/lib/supabase/service.ts).
# NEVER add the NEXT_PUBLIC_ prefix, never import it in client code, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY. Random secret (at least 32 characters) used to create customers'
# tracking links. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it later makes existing tracking links stop working.
TRACKING_TOKEN_SECRET=

# Public site URL, used later when generating table QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
